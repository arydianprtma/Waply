# Nginx Reverse Proxy Configuration for Waply WhatsApp Gateway
# Place in: /etc/nginx/sites-available/ardp.my.id
# Enable with: sudo ln -s /etc/nginx/sites-available/ardp.my.id /etc/nginx/sites-enabled/
# Test with: sudo nginx -t && sudo systemctl reload nginx

server {
    server_name ardp.my.id;

    client_max_body_size 25M;

    # 1. Frontend Web & Next.js API Routes (Port 3001)
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        
        # WebSocket & Header forwarding
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout settings
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # 2. Gateway Worker API & Socket (Port 3002) - Optional if exposed directly
    location /api/gateway/ {
        proxy_pass http://127.0.0.1:3001/api/gateway/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
