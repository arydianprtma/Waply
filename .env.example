# ==========================================
# SENDORA WHATSAPP GATEWAY - ENVIRONMENT CONFIG
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
GATEWAY_URL=http://localhost:3002

# Supabase (Optional / Fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# SMTP Mail Server (Custom Email Service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Sendora Gateway" <your-email@gmail.com>
