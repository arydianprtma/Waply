# ============================================================
# WAPLY PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env on your VPS:
#   cp .env.example .env
# Then fill in your real credentials.

# --- Domain & URL Settings ---
NEXT_PUBLIC_APP_URL=https://waply.web.id
GATEWAY_INTERNAL_URL=http://waply-gateway:3002
PORT=3001
NODE_ENV=production

# --- Database Connection ---
# Opsi 1: PostgreSQL Lokal di Docker VPS (Default & Mandiri)
POSTGRES_USER=waply
POSTGRES_PASSWORD=ganti_dengan_password_db_rahasia_anda
POSTGRES_DB=waply
DATABASE_URL="postgresql://waply:ganti_dengan_password_db_rahasia_anda@waply-db:5432/waply?schema=public"
DIRECT_URL="postgresql://waply:ganti_dengan_password_db_rahasia_anda@waply-db:5432/waply?schema=public"

# Opsi 2: Menggunakan Supabase Cloud Eksternal (Opsional)
# DATABASE_URL="postgresql://postgres.xxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth & Storage (Jika menggunakan fitur Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Midtrans Payment Gateway ---
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=true

# --- Security & JWT ---
JWT_SECRET=super_secret_jwt_key_minimum_32_characters_long

# --- SMTP Email Service (Invoice & Notification) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Waply Support <support@yourdomain.com>"
SMTP_NOREPLY_FROM="Waply Security <noreply@yourdomain.com>"
